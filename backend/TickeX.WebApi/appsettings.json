{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=tickex_dev.db",
    "Redis": "localhost:6379,abortConnect=false",
    "HangfireConnection": ""
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "QueueName": "ticket_events",
    "UserName": "",
    "Password": "",
    "Port": 5672,
    "UseTls": false
  },
  "Jwt": {
    "Key": "",
    "Issuer": "TickeX",
    "Audience": "TickeXClient",
    "AccessTokenMinutes": 15
  },
  "Authentication": {
    "Cookie": {
      "AccessCookieName": "tickex_access",
      "CsrfCookieName": "XSRF-TOKEN",
      "Secure": true,
      "SameSite": "Lax",
      "LifetimeMinutes": 60
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "TicketSecurity": {
    "ActiveKeyId": "key-2026-v1",
    "SecretKeys": {}
  },
  "PayOS": {
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "ReturnUrl": "",
    "CancelUrl": ""
  },
  "Smtp": {
    "Server": "smtp.example.com",
    "Port": "587",
    "Username": "your_email@example.com",
    "Password": "",
    "FromEmail": ""
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
